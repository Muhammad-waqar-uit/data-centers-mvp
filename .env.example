# ─── Smart Contracts (Foundry) ─────────────────────────────
PRIVATE_KEY=
RPC_URL=
ETHERSCAN_API_KEY=
USDC_ADDRESS=

# ─── Backend (NestJS) ─────────────────────────────────────
# Database: paste your Supabase connection string below
# (or uncomment DATABASE_HOST/PORT/USER/PASSWORD/NAME for local Postgres)
DATABASE_URL=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=data_centers
# ─── Redis (OPTIONAL — leave empty to skip) ────────────
# REDIS_HOST=
# REDIS_PORT=6379
JWT_SECRET=
JWT_EXPIRATION=7d
BLOCKCHAIN_RPC_URL=
CLAIM_VERIFICATION_CONTRACT_ADDRESS=
DATA_CENTER_REGISTRY_CONTRACT_ADDRESS=
USDC_CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3001

# ─── Frontend (Next.js) ───────────────────────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MAPLIBRE_STYLE=
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_CLAIM_VERIFICATION_CONTRACT=
NEXT_PUBLIC_DATA_CENTER_REGISTRY_CONTRACT=
NEXT_PUBLIC_USDC_CONTRACT=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
