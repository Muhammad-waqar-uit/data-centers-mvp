# Backend Environment Variables
# Copy this file to .env and fill in the values

# ─── Server ──────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Database (PostgreSQL) ───────────────────────────
# Option A: Supabase (recommended for MVP) — paste your connection string below
# Get it from: Supabase Dashboard → Settings → Database → Connection string → Choose "Transaction" pooler
DATABASE_URL=

# Option B: Local PostgreSQL — uncomment and fill if not using Supabase
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_NAME=data_centers

# ─── Redis (BullMQ — OPTIONAL) ─────────────────────
# Leave REDIS_HOST empty/commented to run without Redis.
# Claim auto-finalization will be disabled, everything else works.
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ─── JWT Auth ────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=7d

# ─── Blockchain ──────────────────────────────────────
BLOCKCHAIN_RPC_URL=
CLAIM_VERIFICATION_CONTRACT_ADDRESS=
DATA_CENTER_REGISTRY_CONTRACT_ADDRESS=
STAKE_MANAGER_CONTRACT_ADDRESS=
USDC_CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# ─── Supabase (optional, for auth/storage) ───────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── File Storage ───────────────────────────────────
# Proof documents stored locally in backend/uploads/
# Served at http://localhost:3001/uploads/<filename>

# ─── CORS ────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
